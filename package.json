{
  "name": "PrismPlay",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "pnpm build:client && pnpm build:server",
    "start": "NODE_ENV=production node dist/backend/backend/server/index.js",
    "dev:client": "vite --host",
    "dev:server": "nodemon",
    "dev": "NODE_ENV=development  concurrently \"pnpm dev:server\" \"pnpm dev:client\"",
    "deploy": "git subtree push --prefix dist origin gh-pages",
    "benchmark": "concurrently -k -s first \"NODE_ENV=production ts-node src/backend/server/index.ts\" \"pnpm autocannon -c 100 -d 10 https://localhost:9443/healthcheck\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^9.39.4",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autocannon": "^8.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "baseline-browser-mapping": "^2.10.27",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "react-refresh": "^0.18.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^8.3.0",
    "@fastify/swagger": "^9.7.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4.2.4",
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "lucide-react": "^0.553.0",
    "nanoid": "^5.1.11",
    "prisma": "^6.19.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.14.2",
    "react-router-dom": "^7.14.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.2.4",
    "uuid": "^13.0.2",
    "zod": "^4.4.3"
  }
}
